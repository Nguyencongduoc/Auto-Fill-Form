{
  "manifest_version": 3,
  "name": "Auto Fill Form — Microsoft Forms",
  "version": "0.3.0",
  "description": "Thư viện đáp án JSON cho Microsoft Forms: nhập, biên soạn, lưu theo form, điền và hoàn tác. Có sẵn bộ Quy chế 2026.1.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Mở Auto Fill Form" },
  "side_panel": { "default_path": "panel.html" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
